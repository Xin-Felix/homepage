<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#0b0d0f" />
<title><%= project.name %> · <%= p.name %></title>
<meta name="description" content="<%= project.description || project.name %>" />
<%- include('partials/seo', { seo }) %>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="stylesheet" href="/css/site.css" />
<script src="/js/site.js"></script>
</head>
<body>
<div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>
<header class="detail-header">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">HX</span><span class="brand-copy"><strong><%= p.name %></strong><small>PROJECT CASE</small></span></a>
  <div class="detail-actions">
    <a class="button button--ghost" href="/#projects">← 返回项目</a>
    <button class="icon-button" id="theme-toggle" type="button" aria-label="切换明暗主题"><svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg><svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg></button>
  </div>
</header>
<main class="detail-shell">
  <section class="detail-hero reveal is-visible">
    <div class="card-no">PROJECT CASE / <%= project.slug.toUpperCase() %></div>
    <h1><%= project.name %></h1>
    <p><%= project.description || '' %></p>
    <dl class="detail-meta">
      <% if (project.role) { %><div><dt>我的角色</dt><dd><%= project.role %></dd></div><% } %>
      <% if (project.period) { %><div><dt>项目时间</dt><dd><%= project.period %></dd></div><% } %>
      <div><dt>技术标签</dt><dd><%= project.meta.join(' · ') || '—' %></dd></div>
    </dl>
    <% if (project.link) { %><a class="button button--primary" href="<%= project.link %>" target="_blank" rel="noopener">查看代码 / 项目 ↗</a><% } %>
  </section>
  <article class="markdown-body">
    <!-- contentHtml 由 marked 解析并经 sanitize-html 白名单过滤后才允许原样输出。 -->
    <%- contentHtml %>
  </article>
  <nav class="detail-footer"><a href="/#projects">← 返回全部项目</a><span><%= views %> 次独立访问</span></nav>
</main>
<footer class="footer"><div><span>© <%= year %> <%= p.footerText %></span><span>PROJECT CASE STUDY</span></div><a href="#top">BACK TO TOP ↑</a></footer>
</body>
</html>
