<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#0b0d0f" />
<title><%= note.title %> · <%= p.name %></title>
<meta name="description" content="<%= note.summary %>" />
<%- include('partials/seo', { seo }) %>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="stylesheet" href="/css/site.css" /><script src="/js/site.js"></script>
</head>
<body>
<header class="detail-header"><a class="brand" href="/"><span class="brand-mark">HX</span><span class="brand-copy"><strong><%= p.name %></strong><small>ENGINEERING NOTE</small></span></a><div class="detail-actions"><a class="button button--ghost" href="/notes">← 全部笔记</a><button class="icon-button" id="theme-toggle" type="button" aria-label="切换明暗主题"><svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg><svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg></button></div></header>
<main class="detail-shell note-detail">
  <header class="detail-hero"><div class="note-tags"><% for (const tag of note.tags) { %><span><%= tag %></span><% } %></div><h1><%= note.title %></h1><p><%= note.summary %></p><div class="note-byline"><span>发布于 <%= formatDate(note.publishedAt) %></span><span>更新于 <%= formatDate(note.updatedAt) %></span><span>阅读 <%= note.readCount %></span></div></header>
  <article class="markdown-body"><!-- HTML 已经过 sanitize-html 白名单过滤。 --><%- contentHtml %></article>
  <nav class="detail-footer"><a href="/notes">← 返回技术笔记</a><span><%= views %> 次独立访问</span></nav>
</main>
<footer class="footer"><div><span>© <%= year %> <%= p.footerText %></span><span>ENGINEERING NOTES</span></div><a href="#top">BACK TO TOP ↑</a></footer>
</body></html>
