# 复制为 .env 后修改：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交；不要把真实密码或 SMTP 授权码写进本文件

# 后台登录密码（必填，建议 16 位以上）
ADMIN_PASSWORD=change-me-to-a-long-password

# MySQL 密码（必填）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# 本机端口（可选）
# APP_PORT=8080
# MYSQL_PORT=3307

# 独立访问统计（同一 IP 在该窗口内只计一次）
# VISITOR_UNIQUE_WINDOW=24h
# VISITOR_MAX_TRACKED_IPS=100000

# 真实 SMTP 留言提醒（可选，以下为 QQ 邮箱示例）
# MAIL_PASSWORD 请填写 SMTP 授权码，不是邮箱登录密码
# NOTIFY_EMAIL=you@example.com
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_AUTH=true
# MAIL_SSL=true
# MAIL_STARTTLS=false
# MAIL_USERNAME=xxx@qq.com
# MAIL_PASSWORD=your-smtp-auth-code

# Gmail / 使用 STARTTLS 的服务通常使用：
# MAIL_PORT=587
# MAIL_SSL=false
# MAIL_STARTTLS=true
