# 复制为 .env 后修改：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# 后台登录密码（必填，建议 16 位以上）
ADMIN_PASSWORD=change-me-to-a-long-password

# MySQL 密码（必填）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# 本机端口（可选）
# APP_PORT=8080
# MYSQL_PORT=3307
# MAILPIT_PORT=8025

# 留言邮件提醒（可选）。不改的话提醒邮件会发到本地 Mailpit：http://localhost:8025
# 换成真实邮箱，以 QQ 邮箱为例（MAIL_PASSWORD 填 SMTP 授权码）：
# NOTIFY_EMAIL=you@example.com
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_SSL=true
# MAIL_USERNAME=xxx@qq.com
# MAIL_PASSWORD=your-smtp-auth-code
