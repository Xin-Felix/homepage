# 复制为 .env 后修改：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交；不要把真实密码或 SMTP 授权码写进本文件

# 后台固定账号和密码（必填；密码建议 16 位以上）
ADMIN_USERNAME=change-me-admin-username
ADMIN_PASSWORD=change-me-to-a-long-password

# MySQL 密码（必填）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# 本机端口与站点地址（部署时 SITE_URL 改成真实 HTTPS 域名）
# APP_PORT=8080
# MYSQL_PORT=3307
SITE_URL=http://localhost:8080
# frontend 访问 Spring 的地址；默认 Docker 服务名即可，通常无需修改
# BACKEND_ORIGIN=http://backend:8080

# 独立访问统计（同一 IP 在该窗口内只计一次，日志持久化到数据库）
# 建议为 VISITOR_HASH_SALT 生成独立随机值，例如：openssl rand -hex 32
# 日志保留期必须大于或等于去重窗口
# VISITOR_UNIQUE_WINDOW=24h
# VISITOR_LOG_RETENTION=90d
VISITOR_HASH_SALT=change-me-to-a-random-64-character-hex-value

# TOTP secret 的 AES-GCM 加密密钥（必填，独立生成：openssl rand -hex 32）
TOTP_ENCRYPTION_KEY=change-me-to-another-random-64-character-hex-value
# TOTP_KEY_ID=v1
# TOTP_ISSUER=huangxin.work

# 真实 SMTP 留言提醒（可选，以下为 QQ 邮箱示例）
# MAIL_PASSWORD 请填写 SMTP 授权码，不是邮箱登录密码
# NOTIFY_EMAIL=you@example.com
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_AUTH=true
# MAIL_SSL=true
# MAIL_STARTTLS=false
# MAIL_USERNAME=xxx@qq.com
# MAIL_PASSWORD=your-smtp-auth-code

# Gmail / 使用 STARTTLS 的服务通常使用：
# MAIL_PORT=587
# MAIL_SSL=false
# MAIL_STARTTLS=true
